# --- Secrets / local configuration ---
# Real credentials must never be committed. .env.example is the tracked template.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Circle entity-secret recovery file. Generated by scripts/setup_arc_wallet.py
# and the only way to reset the entity secret if it is lost -- never commit it.
recovery/

# --- Local-only source material ---
# Original Portuguese spec: kept on disk, superseded by docs/spec-tameion-project.md.
# Not committed: the public repository is English-only.
docs/spec-projeto-tameion.md

# Personal working notes: not part of the deliverable.
docs/TODO.md
docs/revisao-priorizada.md

# --- Local runtime data ---
# Audit log and any other local state written at runtime (see AUDIT_LOG_PATH).
data/
*.jsonl
*.db
*.sqlite
*.sqlite3
*.log

# --- Python virtual environments ---
venv/
.venv/
env/
ENV/
.python-version

# --- Python build artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
wheels/
pip-wheel-metadata/

# --- Test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
*.pyc

# --- Editors and OS ---
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Generated demo output ---
# Rewritten by demo/seed_scenarios.py on every run (demo/run_demo.sh calls it
# first), so these are generated artifacts, not source.
demo/scenarios/

# Business rules: generated with defaults on first read (src/config.py), then
# edited per deployment. Machine-specific, so not versioned -- the defaults
# live in src/config.py and the file is recreated on demand.
config/rules.yaml

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Throwaway directories from running the suite and the toolchain. The pytest
# basetemp in particular is created inside the workspace when the OS temp dir
# is not usable, and it must never end up in a commit.
.pyt*/
.uvcache*/
.backup-atual/
uv-*.lock
.commitmsg