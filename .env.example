# Decision engine backend: kev (default, self-hosted), jev (real API), or
# mock (offline keyword heuristics for demos; entries are tagged "mock").
DECISION_ENGINE=kev
# Seconds to wait for the engine (default 15). A self-hosted model on a CPU can be
# slower than that: use "none" to wait as long as it takes.
# ENGINE_TIMEOUT_SECONDS=none
# Jev only: pin a version for reproducible decisions. "jev-latest" moves when
# TypeSafe releases a new model, which can change scores and confidence.
# JEV_MODEL=jev-1.13.0
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone

# Fallback decision engine: Kev (self-hosted, TypeSafe-System-One-compatible)
# Start it locally first: uv run --extra serve python -m kev.serve --run jaredpalmer/kev-4b --port 8009
FALLBACK_API_URL=http://127.0.0.1:8009/v1/systemone
FALLBACK_API_KEY=local
FALLBACK_MODEL=kev-latest

# Circle / Arc (testnet first -- see src/payments/arc_client.py)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
ARC_BLOCKCHAIN=ARC-TESTNET
ARC_WALLET_ADDRESS=
ARC_WALLET_ID=

# Audit log storage
AUDIT_LOG_PATH=./data/audit_log.jsonl

# On-chain escrow (contractor milestones). Defaults target Arc testnet.
# Set to false to pay milestones with a direct transfer instead of escrow.
# ESCROW_ENABLED=true
# ESCROW_CONTRACT_ADDRESS=0x0747EEf0706327138c69792bF28Cd525089e4583
# ARC_RPC_URL=https://rpc.testnet.arc.io
# Demo mode: a second wallet you control, playing the contractor. The demo
# scenarios pay this wallet (demo/seed_scenarios.py reads it) and the pipeline
# signs the contractor's side of the job. Leave it empty and the demo falls back
# to the conventional burn address, which pays nobody.
ESCROW_PROVIDER_WALLET_ADDRESS=

# Access control. The manager token is REQUIRED for the dashboard and every
# manager API route; without a usable one (16+ chars) they return 503.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
MANAGER_TOKEN=
# Optional: if set, submitting a request from the portal needs this code.
REQUESTER_ACCESS_CODE=
