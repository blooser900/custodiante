# Decision engine
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone

# Fallback decision engine: Kev (self-hosted, TypeSafe-System-One-compatible)
# Start it locally first: uv run --extra serve python -m kev.serve --run jaredpalmer/kev-4b --port 8009
FALLBACK_API_URL=http://127.0.0.1:8009/v1/systemone
FALLBACK_API_KEY=local
FALLBACK_MODEL=kev-latest

# Circle / Arc (testnet first -- see src/payments/arc_client.py)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
ARC_BLOCKCHAIN=ARC-TESTNET
ARC_WALLET_ADDRESS=
ARC_WALLET_ID=

# Audit log storage
AUDIT_LOG_PATH=./data/audit_log.jsonl
